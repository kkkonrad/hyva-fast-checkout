<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
      Auto-discover scalar Cart/Address extension_attributes from all installed modules.
      No per-vendor attribute list: installing a shipping/payment module is enough
      (same integration surface as Magento_Checkout).
    -->
    <type name="Kkkonrad\Fastcheckout\Plugin\Quote\PreserveShippingExtensionAttributes">
        <arguments>
            <argument name="extensionAttributeConfig" xsi:type="object">Magento\Framework\Api\ExtensionAttribute\Config</argument>
            <argument name="attributes" xsi:type="array"/>
        </arguments>
    </type>

    <!-- Global DI: CheckoutLayoutCollector must resolve outside frontend-only config. -->
    <type name="Kkkonrad\Fastcheckout\Model\CheckoutLayoutCollector">
        <arguments>
            <argument name="layoutFactory" xsi:type="object">Magento\Framework\View\LayoutFactory</argument>
            <argument name="moduleList" xsi:type="object">Magento\Framework\Module\ModuleListInterface</argument>
            <argument name="componentRegistrar" xsi:type="object">Magento\Framework\Component\ComponentRegistrarInterface</argument>
            <argument name="serializer" xsi:type="object">Magento\Framework\Serialize\SerializerInterface</argument>
            <argument name="cache" xsi:type="object">Magento\Framework\App\CacheInterface</argument>
            <argument name="storeManager" xsi:type="object">Magento\Store\Model\StoreManagerInterface</argument>
            <argument name="design" xsi:type="object">Magento\Framework\View\DesignInterface</argument>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
        </arguments>
    </type>
    <type name="Magento\Quote\Api\CartRepositoryInterface">
        <plugin name="fastcheckout_preserve_shipping_extension_attributes"
                type="Kkkonrad\Fastcheckout\Plugin\Quote\PreserveShippingExtensionAttributes"/>
    </type>
    <type name="Magento\Quote\Api\CartManagementInterface">
        <plugin name="fastcheckout_place_order_extras"
                type="Kkkonrad\Fastcheckout\Plugin\Quote\PlaceOrderExtrasPlugin"/>
    </type>
    <type name="Magento\Quote\Model\CustomerManagement">
        <plugin name="fastcheckout_quote_customermanagement" type="Kkkonrad\Fastcheckout\Plugin\Quote\CustomerManagementPlugin"/>
    </type>

    <!-- Keep Hyvä's CSS protection, but allow Magento to minify the KO/RequireJS graph. -->
    <type name="Magento\Framework\View\Asset\PreProcessor\Minify">
        <plugin name="hyva_theme"
                type="Kkkonrad\Fastcheckout\Plugin\Theme\AllowJsMinifierForHyvaPlugin"/>
    </type>

    <type name="Tpay\Magento2\Model\ApiFacade\TpayConfig\ConfigOpen">
        <plugin name="fastcheckout_tpay_config_open" type="Kkkonrad\Fastcheckout\Plugin\Tpay\PatchTpayChannelsScript"/>
    </type>
    <type name="Tpay\Magento2\Model\ApiFacade\TpayConfig\ConfigOrigin">
        <plugin name="fastcheckout_tpay_config_origin" type="Kkkonrad\Fastcheckout\Plugin\Tpay\PatchTpayChannelsScript"/>
    </type>

</config>
