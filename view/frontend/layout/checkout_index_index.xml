<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <script src="Kkkonrad_Fastcheckout::js/requirejs-base.js"/>
        <script src="requirejs/require.js"/>
        <script src="mage/requirejs/mixins.js"/>
        <script src="requirejs-config.js"/>
    </head>
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="billing-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="payment" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="additional-payment-validators" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="fastcheckout-one-step-validator" xsi:type="array">
                                                                    <item name="component" xsi:type="string">Kkkonrad_Fastcheckout/js/view/one-step-validator</item>
                                                                    <item name="sortOrder" xsi:type="number">10</item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                        <item name="payments-list" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="before-place-order" xsi:type="array">
                                                                    <item name="children" xsi:type="array">
                                                                        <item name="fastcheckout-newsletter" xsi:type="array">
                                                                            <item name="component" xsi:type="string">Kkkonrad_Fastcheckout/js/view/newsletter</item>
                                                                            <item name="sortOrder" xsi:type="number">90</item>
                                                                            <item name="displayArea" xsi:type="string">before-place-order</item>
                                                                            <item name="provider" xsi:type="string">checkoutProvider</item>
                                                                            <item name="dataScope" xsi:type="string">fastcheckout.subscribe</item>
                                                                        </item>
                                                                    </item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                                <item name="sidebar" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="fastcheckout-order-comment" xsi:type="array">
                                            <item name="component" xsi:type="string">Magento_Ui/js/form/element/textarea</item>
                                            <item name="provider" xsi:type="string">checkoutProvider</item>
                                            <item name="dataScope" xsi:type="string">fastcheckout.comment</item>
                                            <item name="displayArea" xsi:type="string">fastcheckout-order-comment</item>
                                            <item name="sortOrder" xsi:type="number">1000</item>
                                            <item name="label" xsi:type="string" translate="true">Order Comment</item>
                                            <item name="placeholder" xsi:type="string" translate="true">Optional comment for this order</item>
                                            <item name="valueUpdate" xsi:type="string">input</item>
                                            <item name="config" xsi:type="array">
                                                <item name="template" xsi:type="string">Kkkonrad_Fastcheckout/hyva/order-comment</item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
