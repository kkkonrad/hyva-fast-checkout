<?xml version="1.0"?>
<!--
/**
 * Fastcheckout page layout.
 *
 * PR #4: do NOT live-update the Magento OPC handle on this page — on Hyvä
 * without hyva-checkout that handle injects the "No Checkout module installed"
 * notice and Luma OPC chrome. Third-party jsLayout + head assets are merged in
 * PHP via CheckoutLayoutCollector (full Magento layout resolution for the OPC
 * handle in an isolated layout build) and rendered by the KO bridge templates.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <script src="Kkkonrad_Fastcheckout::js/requirejs-base.js"/>
        <script src="requirejs/require.js"/>
        <css src="Kkkonrad_Fastcheckout::css/hyva-ko-payment.css"/>
        <css src="Kkkonrad_Fastcheckout::css/hyva-default-checkout.css"/>
    </head>
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="header-content"
                        template="Kkkonrad_Fastcheckout::hyva/header-logo.phtml"/>
        <referenceBlock name="footer-content"
                        template="Kkkonrad_Fastcheckout::hyva/footer-copyright.phtml"/>
        <referenceBlock name="messages" remove="true"/>
        <referenceBlock name="script-alpine-js" remove="true"/>
        <referenceBlock name="require-alpine-v3" remove="true"/>
        <!-- Defensive: if any theme still pulls OPC root onto this route, drop it. -->
        <referenceBlock name="checkout.root" remove="true"/>
        <referenceContainer name="after.body.start">
            <block class="Magento\RequireJs\Block\Html\Head\Config"
                   name="kkkonrad.fastcheckout.requirejs.config"/>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Kkkonrad\Fastcheckout\Block\Hyva\Checkout"
                   name="kkkonrad.fastcheckout.hyva.checkout"
                   template="Kkkonrad_Fastcheckout::hyva/checkout.phtml"
                   cacheable="false"/>
            <block class="Kkkonrad\Fastcheckout\Block\Hyva\Checkout"
                   name="kkkonrad.fastcheckout.hyva.checkout.ko_checkout_bridge"
                   as="ko_checkout_bridge"
                   template="Kkkonrad_Fastcheckout::hyva/knockout/checkout-renderers.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
