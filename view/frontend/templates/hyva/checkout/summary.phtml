<?php
/**
 * Native order summary and shipping information.
 *
 * Core OPC has no storefront order-comment field, so the existing FC textarea
 * is appended to payment data by the place-order mixin.
 *
 * @var \Kkkonrad\Fastcheckout\Block\Hyva\Checkout $block
 * @var \Magento\Framework\Escaper $escaper
 */
$isTwoStep = $block->isTwoStep();
$separateOrderActions = $block->isSeparateOrderActions() && !$isTwoStep;
$placeOrderOutsideSummary = $block->isPlaceOrderOutsideSummary() && !$isTwoStep;
?>
<!-- Container 4: Order Summary -->
<div class="fc-container-4 space-y-6 min-w-0 w-full">
    <?php if ($placeOrderOutsideSummary): ?>
        <div class="sticky top-6 space-y-6">
    <?php endif; ?>
    <div class="card<?= $placeOrderOutsideSummary ? ' relative' : ' sticky top-6 space-y-6' ?>">
        <div class="fastcheckout-section-loader"
             data-fastcheckout-section-loader="summary"
             role="status"
             aria-label="<?= $escaper->escapeHtmlAttr(__('Loading checkout...')) ?>"></div>
        <div class="relative space-y-6">
            <div class="flex items-center justify-between border-b border-gray-200 pb-3 mb-4">
                <h2 class="text-xl font-semibold text-gray-900">
                    <?= $escaper->escapeHtml(__('Order Summary')) ?>
                </h2>
                <span class="text-xs bg-gray-100 text-gray-800 px-2 py-0.5 rounded-full font-semibold">
                    <?= $escaper->escapeHtml(__('%1 item(s)', (float)$block->getQuote()->getItemsQty())) ?>
                </span>
            </div>

            <?php /* Native Magento KO summary: cart items, totals and third-party children. */ ?>
            <div id="fastcheckout-ko-summary-root"
                 class="fastcheckout-ko-summary-root hidden"
                 data-bind="scope: 'checkout.sidebar.summary'"
                 data-fastcheckout-native-summary>
                <!-- ko template: getTemplate() --><!-- /ko -->
            </div>

            <div id="fastcheckout-ko-shipping-information-root"
                 data-bind="scope: 'checkout.sidebar'"
                 data-fastcheckout-shipping-information>
                <!-- ko foreach: getRegion('shipping-information') -->
                    <!-- ko template: getTemplate() --><!-- /ko -->
                <!-- /ko -->
            </div>

            <?php if (!$isTwoStep && (!$placeOrderOutsideSummary || !$separateOrderActions)): ?>
                <?php $renderOrderExtras = !$placeOrderOutsideSummary || !$separateOrderActions; ?>
                <?php $renderPlaceOrder = !$placeOrderOutsideSummary; ?>
                <?php $placeOrderOutsideContainer = false; ?>
                <?php // phpcs:ignore Magento2.Security.IncludeFile.FoundIncludeFile -- trusted module template. ?>
                <?php include $block->getTemplateFile('Kkkonrad_Fastcheckout::hyva/checkout/order-actions.phtml'); ?>
            <?php endif; ?>
        </div>
    </div>

    <?php if ($placeOrderOutsideSummary): ?>
            <?php $renderOrderExtras = $separateOrderActions; ?>
            <?php $renderPlaceOrder = true; ?>
            <?php $placeOrderOutsideContainer = true; ?>
            <?php // phpcs:ignore Magento2.Security.IncludeFile.FoundIncludeFile -- trusted module template. ?>
            <?php include $block->getTemplateFile('Kkkonrad_Fastcheckout::hyva/checkout/order-actions.phtml'); ?>
        </div>
    <?php endif; ?>
</div>
