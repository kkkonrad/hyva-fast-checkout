<?php
/**
 * Order summary, coupon and place-order controls.
 *
 * Coupon uses Magento_SalesRule payment/discount (native KO).
 * Core OPC has no storefront order-comment field, so the existing FC textarea
 * is appended to payment data by the place-order mixin.
 *
 * @var \Kkkonrad\Fastcheckout\Block\Hyva\Checkout $block
 * @var \Magento\Framework\Escaper $escaper
 * @var array $items
 */
$showComment = $block->isShowComment();
$showSubscribe = $block->isShowSubscribe();
?>
<!-- Container 4: Order Summary, Coupon & Place Order -->
<div class="fc-container-4 space-y-6 min-w-0 w-full">
    <div class="card sticky top-6 space-y-6" data-fastcheckout-totals-card>
        <div class="relative space-y-6">
            <div class="flex items-center justify-between border-b border-gray-200 pb-3 mb-4">
                <h2 class="text-xl font-semibold text-gray-900">
                    <?= $escaper->escapeHtml(__('Order Summary')) ?>
                </h2>
                <span class="text-xs bg-gray-100 text-gray-800 px-2 py-0.5 rounded-full font-semibold"
                      data-fastcheckout-summary-item-count>
                    <?= $escaper->escapeHtml(__('%1 item(s)', $block->getItemsQty())) ?>
                </span>
            </div>

            <?php
            /**
             * Native Magento KO summary (cart items + totals, Magento_Tax templates).
             * Mounted by checkout-renderers.js.
             * SSR below is progressive enhancement until KO binds.
             */
            ?>
            <div id="fastcheckout-ko-summary-root"
                 class="fastcheckout-ko-summary-root hidden"
                 data-bind="scope: 'checkout.sidebar.summary'"
                 data-fastcheckout-native-summary>
                <!-- ko template: getTemplate() --><!-- /ko -->
            </div>

            <div data-fastcheckout-summary-ssr>
                <ul class="space-y-3 max-h-60 overflow-y-auto pr-1">
                    <?php foreach ($items as $item): ?>
                        <li class="flex gap-3 py-1">
                            <img class="h-14 w-14 shrink-0 rounded border border-gray-200 object-contain bg-gray-50"
                                 src="<?= $escaper->escapeUrl($block->getItemImageUrl($item)) ?>"
                                 alt="<?= $escaper->escapeHtmlAttr($item->getName()) ?>"
                                 width="<?= (int)$block->getItemImageWidth($item) ?>"
                                 height="<?= (int)$block->getItemImageHeight($item) ?>"
                                 loading="lazy"/>
                            <div class="min-w-0 flex-1">
                                <h3 class="text-sm font-medium text-gray-800 truncate" title="<?= $escaper->escapeHtmlAttr($item->getName()) ?>">
                                    <?= $escaper->escapeHtml($item->getName()) ?>
                                </h3>
                                <?php $options = $block->getItemOptions($item); ?>
                                <?php if (!empty($options)): ?>
                                    <div class="mt-1 space-y-0.5">
                                        <?php foreach ($options as $option): ?>
                                            <div class="text-[11px] text-gray-500">
                                                <?= $escaper->escapeHtml($option['label'] ?? '') ?>:
                                                <?= $escaper->escapeHtml(is_array($option['value'] ?? null) ? implode(', ', $option['value']) : ($option['value'] ?? '')) ?>
                                            </div>
                                        <?php endforeach; ?>
                                    </div>
                                <?php endif; ?>
                                <div class="mt-1 text-xs text-gray-500">
                                    × <?= (float)$item->getQty() ?>
                                </div>
                            </div>
                            <div class="text-sm font-semibold text-gray-900 shrink-0 text-right">
                                <?= /* @noEscape */ $block->formatPrice($block->getItemRowTotal($item)) ?>
                            </div>
                        </li>
                    <?php endforeach; ?>
                </ul>

                <div class="border-t border-gray-200 pt-4 space-y-2" data-fastcheckout-summary-totals>
                    <?php foreach ($block->getSummaryTotals() as $total): ?>
                        <div class="flex justify-between text-sm <?= !empty($total['strong']) ? 'font-bold text-base pt-2 border-t border-gray-100' : 'text-gray-700' ?>"
                             data-fastcheckout-total-row="<?= $escaper->escapeHtmlAttr($total['code']) ?>">
                            <span><?= $escaper->escapeHtml($total['label']) ?></span>
                            <span data-fastcheckout-total-value="<?= $escaper->escapeHtmlAttr($total['code']) ?>">
                                <?= /* @noEscape */ $block->formatPrice($total['value']) ?>
                            </span>
                        </div>
                    <?php endforeach; ?>
                </div>
            </div>

            <?php if ($showComment): ?>
                <div class="border-t border-gray-200 pt-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="fastcheckout-comment">
                            <?= $escaper->escapeHtml(__('Order Comment')) ?>
                        </label>
                        <textarea id="fastcheckout-comment"
                                  name="fastcheckout_comment"
                                  data-fastcheckout-comment
                                  class="form-input w-full"
                                  rows="2"
                                  placeholder="<?= $escaper->escapeHtmlAttr(__('Optional comment for this order')) ?>"></textarea>
                    </div>
                </div>
            <?php endif; ?>

            <?php if ($showSubscribe): ?>
                <div class="border-t border-gray-200 pt-4">
                    <label class="flex items-center gap-2 text-sm text-gray-700 mb-0 cursor-pointer">
                        <input type="checkbox"
                               id="fastcheckout-subscribe"
                               name="fastcheckout_subscribe"
                               data-fastcheckout-subscribe
                               class="form-checkbox"
                               value="1"
                            <?= $block->getHelper()->isSubscribeByDefault() ? 'checked' : '' ?> />
                        <span><?= $escaper->escapeHtml(__('Sign Up for Our Newsletter')) ?></span>
                    </label>
                </div>
            <?php endif; ?>

            <?php
            /**
             * The visible FC button delegates to the active renderer's native
             * place-order button. The native button stays in its original DOM so
             * payment-specific and additional validators keep their context.
             */
            ?>
            <div class="pt-2 fastcheckout-place-order-section">
                <div id="fastcheckout-place-order-host"
                     class="fastcheckout-place-order-host hidden md:block"
                     data-fastcheckout-place-order-host>
                </div>
                <?php /* Always available; the native checkout validators run on click. */ ?>
                <button class="btn btn-primary w-full items-center justify-center gap-2 hidden md:flex fastcheckout-place-order-btn"
                        type="button"
                        data-fastcheckout-place-order
                        data-fastcheckout-place-order-ssr>
                    <span class="place-order-spinner hidden" data-fastcheckout-place-order-spinner aria-hidden="true">
                        <svg class="animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </span>
                    <span data-fastcheckout-place-order-label
                          data-fastcheckout-ready-text="<?= $escaper->escapeHtmlAttr(__('Place Order')) ?>"
                          data-fastcheckout-processing-text="<?= $escaper->escapeHtmlAttr(__('Please wait...')) ?>">
                        <?= $escaper->escapeHtml(__('Place Order')) ?>
                    </span>
                </button>
                <p class="text-sm text-red-600 font-medium text-center mt-2 hidden"
                   data-fastcheckout-client-order-error
                   role="alert"></p>
            </div>
        </div>
    </div>
</div>
