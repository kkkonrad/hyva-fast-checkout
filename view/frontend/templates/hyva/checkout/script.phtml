<?php
/**
 * Fastcheckout shell — place order + coupon via RequireJS/KO (no Alpine/Magewire quote owner).
 *
 * @var \Kkkonrad\Fastcheckout\Block\Hyva\Checkout $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp
 */
$hyvaCsp = $block->getHyvaCsp();
?>
<script>
(function () {
    'use strict';

    var form = document.getElementById('co-checkout-form');
    if (!form) {
        return;
    }

    window.fastcheckoutNativeQuotePipeline = true;

    function setProcessing(isProcessing) {
        document.body.classList.toggle('checkout-submitting', !!isProcessing);
        form.querySelectorAll('[data-fastcheckout-place-order-spinner]').forEach(function (el) {
            el.classList.toggle('hidden', !isProcessing);
            el.setAttribute('aria-hidden', isProcessing ? 'false' : 'true');
        });
        form.querySelectorAll('[data-fastcheckout-place-order], [data-fastcheckout-place-order-mobile]').forEach(function (btn) {
            var label = btn.querySelector('[data-fastcheckout-place-order-label]');

            if (isProcessing) {
                var buttonStyle = window.getComputedStyle(btn);

                // Preserve the active Hyvä primary-button palette. The global
                // disabled style normally lowers opacity and changes the color.
                btn.style.setProperty('--fastcheckout-place-order-background', buttonStyle.backgroundColor);
                btn.style.setProperty('--fastcheckout-place-order-color', buttonStyle.color);
                btn.style.setProperty('--fastcheckout-place-order-border', buttonStyle.borderColor);
                btn.setAttribute('data-fastcheckout-processing', 'true');
                btn.setAttribute('aria-busy', 'true');
            } else {
                btn.removeAttribute('data-fastcheckout-processing');
                btn.removeAttribute('aria-busy');
                btn.style.removeProperty('--fastcheckout-place-order-background');
                btn.style.removeProperty('--fastcheckout-place-order-color');
                btn.style.removeProperty('--fastcheckout-place-order-border');
            }

            btn.disabled = !!isProcessing;
            btn.classList.toggle('pointer-events-none', !!isProcessing);

            if (label) {
                label.textContent = isProcessing
                    ? label.getAttribute('data-fastcheckout-processing-text')
                    : label.getAttribute('data-fastcheckout-ready-text');
            }
        });
    }

    function showError(message) {
        form.querySelectorAll('[data-fastcheckout-client-order-error]').forEach(function (el) {
            if (message) {
                el.textContent = message;
                el.classList.remove('hidden');
            } else {
                el.textContent = '';
                el.classList.add('hidden');
            }
        });
        window.fastcheckoutLastShippingValidationError = message || '';
    }

    function getSelectedPaymentMethod() {
        var checked = form.querySelector('input[name="payment_method"]:checked:not(:disabled)');
        return checked ? checked.value : '';
    }

    function placeOrderViaKo() {
        var selectedMethod = getSelectedPaymentMethod();
        var paymentBridge = window.fastcheckoutHyvaPayment;
        var shippingBridge = window.fastcheckoutHyvaShipping;

        showError('');

        if (shippingBridge && typeof shippingBridge.validate === 'function' && !shippingBridge.validate()) {
            var shipMsg = window.fastcheckoutLastShippingValidationError || 'Please complete shipping information.';
            showError(shipMsg);
            return Promise.reject(new Error(shipMsg));
        }

        if (!selectedMethod) {
            var payMsg = 'Please select a payment method.';
            showError(payMsg);
            return Promise.reject(new Error(payMsg));
        }

        // Run the same native Magento/KO field validation as the payment
        // renderer before starting shipping synchronisation or showing the
        // checkout processing state. Invalid fields (for example an empty
        // Purchase Order Number) must behave like shipping address fields:
        // render their inline error immediately and send no REST request.
        if (
            paymentBridge &&
            typeof paymentBridge.validate === 'function' &&
            !paymentBridge.validate()
        ) {
            if (typeof paymentBridge.focusFirstInvalidField === 'function') {
                paymentBridge.focusFirstInvalidField();
            }

            return Promise.reject(new Error('Please check the selected payment method and try again.'));
        }

        setProcessing(true);

        // Prefer payment bridge placeOrder (KO renderer path). No Magewire.
        if (paymentBridge && typeof paymentBridge.placeOrder === 'function') {
            return Promise.resolve(paymentBridge.placeOrder(null, selectedMethod))
                .then(function (result) {
                    // A successful order starts Magento's redirect flow. Keep the
                    // button busy until the current document is replaced so there
                    // is no idle-button flash between REST success and navigation.
                    if (result && result.redirectUrl) {
                        window.location.replace(result.redirectUrl);
                        return result;
                    }
                    if (paymentBridge.afterPlaceOrder) {
                        paymentBridge.afterPlaceOrder();
                    }
                    return result;
                })
                .catch(function (error) {
                    setProcessing(false);
                    var message = (error && error.message) ? error.message : String(error || 'The order was not placed.');
                    showError(message);
                    window.dispatchEvent(new CustomEvent('fastcheckout:payment-error', { detail: { message: message } }));
                    throw error;
                });
        }

        // Fallback: Magento place-order action via RequireJS
        return new Promise(function (resolve, reject) {
            if (typeof require !== 'function') {
                setProcessing(false);
                reject(new Error('Checkout is not ready.'));
                return;
            }
            require([
                'Magento_Checkout/js/action/place-order',
                'Magento_Checkout/js/model/quote',
                'Magento_Checkout/js/model/error-processor',
                'Magento_Checkout/js/model/full-screen-loader'
            ], function (placeOrderAction, quote, errorProcessor, fullScreenLoader) {
                var payment = quote.paymentMethod && quote.paymentMethod();
                if (!payment || !payment.method) {
                    payment = { method: selectedMethod };
                }
                fullScreenLoader.startLoader();
                placeOrderAction(payment).done(function (result) {
                    fullScreenLoader.stopLoader();
                    // Preserve the button loader through the success-page redirect.
                    if (window.checkoutConfig && window.checkoutConfig.defaultSuccessPageUrl) {
                        window.location.replace(window.checkoutConfig.defaultSuccessPageUrl);
                    } else {
                        window.location.replace('/checkout/onepage/success');
                    }
                    resolve(result);
                }).fail(function (response) {
                    fullScreenLoader.stopLoader();
                    setProcessing(false);
                    try {
                        errorProcessor.process(response);
                    } catch (e) { /* ignore */ }
                    var message = (response && response.responseJSON && response.responseJSON.message)
                        ? response.responseJSON.message
                        : 'The order was not placed.';
                    showError(message);
                    reject(new Error(message));
                });
            }, function () {
                setProcessing(false);
                reject(new Error('Checkout is not ready.'));
            });
        });
    }

    form.addEventListener('submit', function (event) {
        event.preventDefault();
        // Validation and request failures are already rendered by showError() and the
        // Magento message container. Consume the promise here so an expected invalid
        // submit does not become an unhandled browser error.
        placeOrderViaKo().catch(function () {});
    });

    // Coupon apply/cancel via Magento guest/customer coupon REST when available.
    // Messages are rendered server-side so Magento i18n (pl_PL etc.) applies.
    var couponMessages = {
        enterCode: <?= /* @noEscape */ json_encode((string)__('Please enter a discount code.')) ?>,
        applied: <?= /* @noEscape */ json_encode((string)__('Coupon applied.')) ?>,
        removed: <?= /* @noEscape */ json_encode((string)__('Coupon removed.')) ?>,
        applyFailed: <?= /* @noEscape */ json_encode((string)__('Could not apply coupon.')) ?>,
        moduleMissing: <?= /* @noEscape */ json_encode((string)__('Coupon module is not available.')) ?>
    };

    function applyCoupon(remove) {
        var input = document.querySelector('[data-fastcheckout-coupon-input]');
        var messageEl = document.querySelector('[data-fastcheckout-coupon-message]');
        var code = input ? String(input.value || '').trim() : '';

        if (!remove && !code) {
            if (messageEl) {
                messageEl.textContent = couponMessages.enterCode;
                messageEl.classList.remove('hidden', 'text-green-700');
                messageEl.classList.add('text-red-700');
            }
            return;
        }

        if (typeof require !== 'function') {
            return;
        }

        require([
            'Magento_SalesRule/js/action/set-coupon-code',
            'Magento_SalesRule/js/action/cancel-coupon'
        ], function (setCoupon, cancelCoupon) {
            var action = remove ? cancelCoupon() : setCoupon(code);
            Promise.resolve(action).then(function () {
                if (messageEl) {
                    messageEl.textContent = remove ? couponMessages.removed : couponMessages.applied;
                    messageEl.classList.remove('hidden', 'text-red-700');
                    messageEl.classList.add('text-green-700');
                }
                window.setTimeout(function () {
                    window.location.reload();
                }, 400);
            }).catch(function (error) {
                if (messageEl) {
                    messageEl.textContent = (error && error.message) ? error.message : couponMessages.applyFailed;
                    messageEl.classList.remove('hidden', 'text-green-700');
                    messageEl.classList.add('text-red-700');
                }
            });
        }, function () {
            if (messageEl) {
                messageEl.textContent = couponMessages.moduleMissing;
                messageEl.classList.remove('hidden');
            }
        });
    }

    document.addEventListener('click', function (event) {
        var target = event.target;
        if (!target) {
            return;
        }
        if (target.closest('[data-fastcheckout-coupon-apply]')) {
            event.preventDefault();
            applyCoupon(false);
        } else if (target.closest('[data-fastcheckout-coupon-cancel]')) {
            event.preventDefault();
            applyCoupon(true);
        }
    });

    window.addEventListener('fastcheckout:payment-error', function (event) {
        var message = event && event.detail && event.detail.message ? event.detail.message : '';
        if (message) {
            showError(message);
            setProcessing(false);
        }
    });

    window.addEventListener('fastcheckout:shipping-error', function (event) {
        var message = event && event.detail && event.detail.message ? event.detail.message : '';
        if (message) {
            showError(message);
            setProcessing(false);
        }
    });

    // If the browser restores this checkout document from its back-forward cache,
    // it did not create a new DOM and would otherwise restore the busy button.
    window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
            setProcessing(false);
        }
    });
})();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
