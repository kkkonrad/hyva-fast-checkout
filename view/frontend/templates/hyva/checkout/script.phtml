<?php
/**
 * Fastcheckout shell — place order and coupon via RequireJS/KO.
 *
 * @var \Kkkonrad\Fastcheckout\Block\Hyva\Checkout $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp
 */
$hyvaCsp = $block->getHyvaCsp();
$clientMessagePhrases = [
    'Please complete shipping information.',
    'Please select a payment method.',
    'Please select a shipping method.',
    'Please select a shipping method and try again.',
    'Please check the shipping address and try again.',
    'Please check the billing address and try again.',
    'Please check the selected payment method and try again.',
    'The order was not placed.',
    'Checkout is not ready.',
    'Could not estimate shipping rates.',
    'Shipping estimate modules unavailable',
    'Checkout session is not ready. Please refresh the page and try again.',
    'The selected payment method is not ready. Please try again.',
    'The selected payment method did not start order placement. Please try again.',
    'We could not place your order. Please try again.',
    'Something went wrong while processing your order. Please try again later.',
    'This is a required field.',
    'Please select a pickup point'
];
$clientMessages = [];
foreach ($clientMessagePhrases as $phrase) {
    $clientMessages[$phrase] = (string)__($phrase);
}
?>
<script>
(function () {
    'use strict';

    var form = document.getElementById('co-checkout-form');
    if (!form) {
        return;
    }

    window.fastcheckoutNativeQuotePipeline = true;

    // This shell runs before RequireJS is guaranteed to be available, so messages
    // cannot safely depend on mage/translate. Resolve known validation strings on
    // the server and also use the map for English messages returned by JS bridges.
    var clientMessages = <?= /* @noEscape */ json_encode(
        $clientMessages,
        JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    ) ?>;
    var orderIsProcessing = false;
    var isPaymentReady = true;
    var paymentReadinessTimer = null;

    function translateClientMessage(message) {
        var text = message === null || typeof message === 'undefined'
            ? ''
            : String(message);

        return Object.prototype.hasOwnProperty.call(clientMessages, text)
            ? clientMessages[text]
            : text;
    }

    function setProcessing(isProcessing) {
        isProcessing = !!isProcessing;
        orderIsProcessing = isProcessing;
        document.body.classList.toggle('checkout-submitting', !!isProcessing);
        form.querySelectorAll('[data-fastcheckout-place-order-spinner]').forEach(function (el) {
            el.classList.toggle('hidden', !isProcessing);
            el.setAttribute('aria-hidden', isProcessing ? 'false' : 'true');
        });
        form.querySelectorAll('[data-fastcheckout-place-order], [data-fastcheckout-place-order-mobile]').forEach(function (btn) {
            var label = btn.querySelector('[data-fastcheckout-place-order-label]');

            if (isProcessing) {
                var buttonStyle = window.getComputedStyle(btn);

                // Preserve the active Hyvä primary-button palette. The global
                // disabled style normally lowers opacity and changes the color.
                btn.style.setProperty('--fastcheckout-place-order-background', buttonStyle.backgroundColor);
                btn.style.setProperty('--fastcheckout-place-order-color', buttonStyle.color);
                btn.style.setProperty('--fastcheckout-place-order-border', buttonStyle.borderColor);
                btn.setAttribute('data-fastcheckout-processing', 'true');
                btn.setAttribute('aria-busy', 'true');
            } else {
                btn.removeAttribute('data-fastcheckout-processing');
                btn.removeAttribute('aria-busy');
                btn.style.removeProperty('--fastcheckout-place-order-background');
                btn.style.removeProperty('--fastcheckout-place-order-color');
                btn.style.removeProperty('--fastcheckout-place-order-border');
            }

            btn.disabled = isProcessing || !isPaymentReady;
            btn.classList.toggle('pointer-events-none', btn.disabled);
            btn.setAttribute('aria-disabled', btn.disabled ? 'true' : 'false');

            if (label) {
                label.textContent = isProcessing
                    ? label.getAttribute('data-fastcheckout-processing-text')
                    : label.getAttribute('data-fastcheckout-ready-text');
            }
        });
    }

    function showError(message) {
        message = translateClientMessage(message);
        if (message && hasVisibleInlineValidationError(message)) {
            message = '';
        }
        form.querySelectorAll('[data-fastcheckout-client-order-error]').forEach(function (el) {
            if (message) {
                el.textContent = message;
                el.classList.remove('hidden');
            } else {
                el.textContent = '';
                el.classList.add('hidden');
            }
        });
        window.fastcheckoutLastShippingValidationError = message || '';
    }

    function showPaymentSelectionError(message) {
        var error = form.querySelector('[data-fastcheckout-payment-selection-error]');

        if (error) {
            error.firstElementChild.textContent = message || '';
            error.classList.toggle('hidden', !message);
        }
    }

    function getSelectedPaymentMethod() {
        var checked = form.querySelector('input[name="payment_method"]:checked:not(:disabled)');
        return checked ? checked.value : '';
    }

    function hasInlinePaymentError(message) {
        var paymentBridge = window.fastcheckoutHyvaPayment;

        return Boolean(
            paymentBridge &&
            typeof paymentBridge.hasInlineError === 'function' &&
            paymentBridge.hasInlineError(message, getSelectedPaymentMethod())
        );
    }

    function hasVisibleInlineValidationError(message) {
        if (hasInlinePaymentError(message)) {
            return true;
        }

        return Array.prototype.some.call(form.querySelectorAll(
            '[aria-invalid="true"], .admin__field-error, .field-error, label.mage-error, div.mage-error'
        ), function (element) {
            return element.offsetParent !== null && (
                element.matches('[aria-invalid="true"]') ||
                String(element.textContent || '').trim() !== ''
            );
        });
    }

    function refreshPaymentReadiness() {
        var selectedMethod = getSelectedPaymentMethod();
        var paymentBridge = window.fastcheckoutHyvaPayment;
        var isWaiting = false;
        var loader = form.querySelector('[data-fastcheckout-payment-loading]');

        if (selectedMethod) {
            try {
                isPaymentReady = Boolean(
                    paymentBridge &&
                    typeof paymentBridge.isRendererReady === 'function' &&
                    paymentBridge.isRendererReady(selectedMethod)
                );
            } catch (error) {
                isPaymentReady = false;
            }
            isWaiting = !isPaymentReady;
        } else {
            isPaymentReady = true;
        }

        if (loader) {
            loader.classList.toggle('hidden', !isWaiting);
            loader.style.display = isWaiting ? 'flex' : 'none';
            loader.style.pointerEvents = 'none';
            loader.setAttribute('aria-hidden', isWaiting ? 'false' : 'true');
        }

        form.querySelectorAll('[data-fastcheckout-place-order], [data-fastcheckout-place-order-mobile]').forEach(function (btn) {
            btn.disabled = orderIsProcessing || !isPaymentReady;
            btn.classList.toggle('pointer-events-none', btn.disabled);
            btn.setAttribute('aria-disabled', btn.disabled ? 'true' : 'false');
        });

        if (paymentReadinessTimer) {
            window.clearTimeout(paymentReadinessTimer);
            paymentReadinessTimer = null;
        }
        if (isWaiting) {
            paymentReadinessTimer = window.setTimeout(refreshPaymentReadiness, 100);
        }
    }

    function placeOrderViaKo() {
        var selectedMethod = getSelectedPaymentMethod();
        var paymentBridge = window.fastcheckoutHyvaPayment;
        var shippingBridge = window.fastcheckoutHyvaShipping;
        var shippingScrollStart = window.pageYOffset;

        showError('');
        showPaymentSelectionError('');

        if (shippingBridge && typeof shippingBridge.validate === 'function' && !shippingBridge.validate()) {
            var shipMsg = window.fastcheckoutLastShippingValidationError ||
                translateClientMessage('Please complete shipping information.');
            if (typeof shippingBridge.focusFirstInvalidField === 'function') {
                shippingBridge.focusFirstInvalidField(shippingScrollStart);
            }
            showError(shipMsg);
            return Promise.reject(new Error(shipMsg));
        }

        if (!selectedMethod) {
            var payMsg = translateClientMessage('Please select a payment method.');
            showPaymentSelectionError(payMsg);
            if (paymentBridge && typeof paymentBridge.focusFirstInvalidField === 'function') {
                paymentBridge.focusFirstInvalidField();
            }
            return Promise.reject(new Error(payMsg));
        }

        if (
            !paymentBridge ||
            typeof paymentBridge.isRendererReady !== 'function' ||
            typeof paymentBridge.placeOrder !== 'function' ||
            !paymentBridge.isRendererReady(selectedMethod)
        ) {
            var readyMsg = translateClientMessage(
                'The selected payment method is not ready. Please try again.'
            );
            showError(readyMsg);
            return Promise.reject(new Error(readyMsg));
        }

        // Run the same native Magento/KO field validation as the payment
        // renderer before starting shipping synchronisation or showing the
        // checkout processing state. Invalid fields (for example an empty
        // Purchase Order Number) must behave like shipping address fields:
        // render their inline error immediately and send no REST request.
        if (
            paymentBridge &&
            typeof paymentBridge.validate === 'function' &&
            !paymentBridge.validate()
        ) {
            if (typeof paymentBridge.focusFirstInvalidField === 'function') {
                paymentBridge.focusFirstInvalidField();
            }

            return Promise.reject(new Error(
                translateClientMessage('Please check the selected payment method and try again.')
            ));
        }

        return Promise.resolve(paymentBridge.placeOrder(null, selectedMethod))
            .then(function (result) {
                // A successful order starts Magento's redirect flow. Keep the
                // button busy until the current document is replaced so there
                // is no idle-button flash between REST success and navigation.
                if (result && result.redirectUrl) {
                    window.location.replace(result.redirectUrl);
                    return result;
                }
                if (paymentBridge.afterPlaceOrder) {
                    paymentBridge.afterPlaceOrder();
                }
                return result;
            })
            .catch(function (error) {
                setProcessing(false);
                var message = (error && error.message)
                    ? translateClientMessage(error.message)
                    : translateClientMessage(String(error || 'The order was not placed.'));
                if (
                    (error && error.fastcheckoutInlineHandled) ||
                    hasInlinePaymentError(message)
                ) {
                    showError('');
                } else {
                    showError(message);
                    window.dispatchEvent(new CustomEvent('fastcheckout:payment-error', { detail: { message: message } }));
                }
                throw error;
            });
    }

    form.addEventListener('submit', function (event) {
        event.preventDefault();
        // Validation and request failures are already rendered by showError() and the
        // Magento message container. Consume the promise here so an expected invalid
        // submit does not become an unhandled browser error.
        placeOrderViaKo().catch(function () {});
    });
    form.addEventListener('change', function (event) {
        if (event.target && event.target.name === 'payment_method') {
            showPaymentSelectionError('');
            refreshPaymentReadiness();
        }
    });

    document.addEventListener('fastcheckout:payment-components-started', refreshPaymentReadiness);
    document.addEventListener('fastcheckout:payment-selection-changed', refreshPaymentReadiness);
    document.addEventListener('fastcheckout:ready', refreshPaymentReadiness);
    document.addEventListener('fastcheckout:order-submit-started', function () {
        setProcessing(true);
    });

    var paymentGrid = form.querySelector('[data-fastcheckout-payment-methods-grid]');
    if (paymentGrid && typeof window.MutationObserver === 'function') {
        new MutationObserver(refreshPaymentReadiness).observe(paymentGrid, {
            childList: true,
            subtree: true
        });
    }
    refreshPaymentReadiness();

    // Coupon apply/cancel is handled by Magento_SalesRule payment/discount KO component
    // mounted in #fastcheckout-ko-discount-root (see startNativeDiscountComponent).

    window.addEventListener('fastcheckout:payment-error', function (event) {
        var message = event && event.detail && event.detail.message ? event.detail.message : '';
        if (message) {
            showError(hasInlinePaymentError(message) ? '' : message);
        }
        setProcessing(false);
    });

    window.addEventListener('fastcheckout:shipping-error', function (event) {
        var message = event && event.detail && event.detail.message ? event.detail.message : '';
        if (message) {
            showError(message);
            setProcessing(false);
        }
    });

    // If the browser restores this checkout document from its back-forward cache,
    // it did not create a new DOM and would otherwise restore the busy button.
    window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
            setProcessing(false);
        }
    });
})();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
