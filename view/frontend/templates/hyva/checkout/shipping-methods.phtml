<?php
/**
 * Shipping methods — the KO list owns rates after paint.
 *
 * @var \Kkkonrad\Fastcheckout\Block\Hyva\Checkout $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp
 */
// Collect rates with Magento default destination when quote has no country yet.
$shippingMethods = $block->getShippingMethods();
$selectedShipping = $block->getSelectedShippingMethodCode();
$shippingAddress = $block->getQuote() ? $block->getQuote()->getShippingAddress() : null;

$jsRates = [];
foreach ($shippingMethods as $carrierCode => $rates) {
    foreach ($rates as $rate) {
        $priceExcl = $block->getShippingRateAmountExclTax($rate);
        $priceIncl = $block->getShippingRateAmountInclTax($rate);
        // Magento estimate payload uses amount ≈ primary/base; KO list reads
        // price_excl_tax / price_incl_tax when Magento tax display is set.
        $jsRates[] = [
            'carrier_code' => (string)$rate->getCarrier(),
            'method_code' => (string)$rate->getMethod(),
            'carrier_title' => (string)$rate->getCarrierTitle(),
            'method_title' => (string)$rate->getMethodTitle(),
            'amount' => $priceExcl,
            'base_amount' => $priceExcl,
            'price_excl_tax' => $priceExcl,
            'price_incl_tax' => $priceIncl,
            'available' => !$rate->getErrorMessage(),
            'error_message' => (string)$rate->getErrorMessage(),
        ];
    }
}
?>
<!-- Container 2: Shipping Method -->
<div class="fc-container-2 space-y-6 min-w-0 w-full" data-fastcheckout-shipping-methods>
    <div class="card relative">
        <div class="flex items-center justify-between border-b border-gray-200 pb-4 mb-4">
            <h2 class="text-xl font-semibold text-gray-900">
                <?= $escaper->escapeHtml(__('Shipping Method')) ?>
            </h2>
            <div data-fastcheckout-shipping-loading
                 class="text-xs text-primary animate-pulse items-center gap-1.5 hidden">
                <svg class="animate-spin h-3.5 w-3.5 text-primary inline" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="hidden md:inline"><?= $escaper->escapeHtml(__('Updating...')) ?></span>
            </div>
        </div>

        <div class="fastcheckout-ko-shipping-container">
            <?php
            /**
             * Bind to Magento's real shipping view (same instance as the address form).
             * The legacy scope "fastcheckoutHyvaShippingRenderers.shippingList" was never
             * registered, so KO never replaced this SSR markup — rates stayed frozen after
             * the first paint even though shippingService already re-estimated correctly.
             * Explicit shipping-list template (not getTemplate()) so the address form template
             * is not rendered here a second time.
             */
            ?>
            <div id="fastcheckout-ko-shipping-root"
                 class="fastcheckout-ko-shipping-root"
                 data-bind="scope: 'checkout.steps.shipping-step.shippingAddress'">
                <!-- ko template: { name: 'Kkkonrad_Fastcheckout/hyva/shipping-list' } -->
                <?php if (empty($shippingMethods)): ?>
                    <p class="text-sm text-gray-500">
                        <?= $escaper->escapeHtml(__('Please enter your shipping address details to estimate shipping rates.')) ?>
                    </p>
                <?php else: ?>
                    <div class="grid gap-3 relative">
                        <?php foreach ($shippingMethods as $carrierCode => $rates): ?>
                            <?php foreach ($rates as $rate): ?>
                                <?php
                                    $rateCode = $rate->getCarrier() . '_' . $rate->getMethod();
                                    $isSelected = ($selectedShipping === $rateCode);
                                    $cssClass = $isSelected
                                        ? 'border-2 border-primary bg-container'
                                        : 'border-2 border-gray-200 hover:border-gray-300 hover:bg-gray-50/50';
                                ?>
                                <div class="fastcheckout-shipping-method-option rounded p-4 transition-all duration-200 cursor-pointer <?= $escaper->escapeHtmlAttr($cssClass) ?>">
                                    <label class="flex items-center justify-between cursor-pointer mb-0 w-full">
                                        <div class="flex items-center min-w-0">
                                            <input type="radio"
                                                   class="form-radio mr-4 shrink-0"
                                                   name="shipping_method"
                                                   value="<?= $escaper->escapeHtmlAttr($rateCode) ?>"
                                                   <?= $isSelected ? 'checked' : '' ?>
                                                   required />
                                            <div class="min-w-0 pl-4">
                                                <span class="block text-sm font-semibold text-gray-900 leading-tight">
                                                    <?= $escaper->escapeHtml($rate->getMethodTitle()) ?>
                                                </span>
                                                <span class="block text-xs text-gray-500 mt-1" id="label_carrier_<?= $escaper->escapeHtmlAttr($rate->getMethod() . '_' . $rate->getCarrier()) ?>">
                                                    <?= $escaper->escapeHtml($rate->getCarrierTitle()) ?>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="text-sm font-bold text-gray-900 shrink-0 pl-3 text-right">
                                            <?= /* @noEscape */ $block->formatPrice($block->getShippingRateDisplayAmount($rate)) ?>
                                            <?php if ($block->displayShippingBothPrices()
                                                && $block->getShippingRateAmountExclTax($rate) != $block->getShippingRateAmountInclTax($rate)
                                            ): ?>
                                                <span class="block text-xs font-normal text-gray-500 mt-0.5">
                                                    <?= $escaper->escapeHtml(__('Excl. Tax')) ?>:
                                                    <?= /* @noEscape */ $block->formatPrice($block->getShippingRateAmountExclTax($rate)) ?>
                                                </span>
                                            <?php endif; ?>
                                        </div>
                                    </label>
                                    <div id="label_method_<?= $escaper->escapeHtmlAttr($rate->getMethod() . '_' . $rate->getCarrier()) ?>"></div>
                                </div>
                            <?php endforeach; ?>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>
<script>
    window.fastcheckoutInitialShippingRates = <?= /* @noEscape */ $block->serializeForScript($jsRates) ?>;
    window.fastcheckoutInitialShippingMethod = <?= /* @noEscape */ $block->serializeForScript($selectedShipping) ?>;
    window.fastcheckoutDefaultDestination = {
        countryId: <?= /* @noEscape */ $block->serializeForScript(
            $shippingAddress && $shippingAddress->getCountryId()
                ? (string)$shippingAddress->getCountryId()
                : $block->getDefaultDestinationCountryId()
        ) ?>,
        postcode: <?= /* @noEscape */ $block->serializeForScript($shippingAddress ? (string)$shippingAddress->getPostcode() : '') ?>,
        regionId: <?= /* @noEscape */ $block->serializeForScript($shippingAddress ? (string)$shippingAddress->getRegionId() : '') ?>,
        city: <?= /* @noEscape */ $block->serializeForScript($shippingAddress ? (string)$shippingAddress->getCity() : '') ?>
    };
</script>
<?php $hyvaCsp->registerInlineScript() ?>
