<?php
/**
 * Native Magento checkout bootstrap for the existing Fastcheckout presentation.
 *
 * @var KkkonradFastcheckoutBlockHyvaCheckout $block
 * @var MagentoFrameworkEscaper $escaper
 */
$hyvaCsp = $block->getHyvaCsp();
$checkoutConfig = $block->getCheckoutConfig();
$jsLayout = $block->getCheckoutJsLayout();

if ($jsLayout === []) {
    return;
}
?>
<script>
(function () {
    'use strict';

    if (window.location.hash) {
        window.history.replaceState(
            window.history.state,
            document.title,
            window.location.pathname + window.location.search
        );
    }

    window.checkoutConfig = <?= /* @noEscape */ $block->serializeForScript($checkoutConfig) ?>;
    window.isCustomerLoggedIn = Boolean(window.checkoutConfig.isCustomerLoggedIn);
    window.customerData = window.checkoutConfig.customerData || {};
    window.LOCALE = window.LOCALE ||
        '<?= $escaper->escapeJs(str_replace('_', '-', $block->getLocaleCode())) ?>';
    window.BASE_URL = window.BASE_URL || '<?= $escaper->escapeJs($block->getBaseUrl()) ?>';

    require(
        ['Kkkonrad_Fastcheckout/js/hyva/checkout-renderers'],
        function (initializeCheckout) {
            initializeCheckout(<?= /* @noEscape */ $block->serializeForScript($jsLayout) ?>);
        }
    );
})();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
